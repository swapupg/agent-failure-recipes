{
  "name": "agent-failure-recipes",
  "version": "0.1.0",
  "description": "Small, executable failure-and-repair recipes for tool-using agents.",
  "type": "module",
  "license": "MIT",
  "author": "Swapnil Upganlawar",
  "repository": { "type": "git", "url": "https://github.com/swapupg/agent-failure-recipes.git" },
  "homepage": "https://swapupg.github.io/agent-failure-recipes/",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "agent-failure-recipes": "dist/cli.js" },
  "files": ["dist", "src", "examples", "docs/recipes", "README.md", "LICENSE"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4365",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.site.json --noEmit",
    "lint": "eslint src site/src examples tests scripts *.ts",
    "test": "vitest run",
    "build": "tsc && vite build && node scripts/release.mjs",
    "recipes": "node dist/cli.js",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run recipes && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
