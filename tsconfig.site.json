{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"], "skipLibCheck": true, "allowImportingTsExtensions": true
  },
  "include": ["site/src", "src", "tests", "examples", "*.ts"]
}
